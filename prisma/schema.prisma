generator client {
  provider      = "prisma-client-js"
  // Alpine production image needs the musl engine even when generate runs elsewhere.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  BUSINESS
  AGENCY
  ADMIN
}

enum PlanTier {
  STARTER
  PLUS
  PRO
  BUSINESS_FREE
  BUSINESS_PRO
  AGENCY
}

enum DataSource {
  CREATOR_CLAIMED
  PLATFORM_VERIFIED
  PROVIDER_SYNCED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileState {
  UNCLAIMED
  CLAIMED
  VERIFIED
  RESTRICTED
}

enum OnboardingState {
  DRAFT
  CLAIMED
  EMAIL_VERIFIED
  PUBLISHED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  LINKEDIN
  PINTEREST
  WEBSITE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  role            UserRole  @default(CREATOR)
  planTier        PlanTier  @default(STARTER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         Creator?
  business        BusinessProfile?
  consents        ConsentRecord[]
  emailChallenges EmailChallenge[]
  passwordResets  PasswordReset[]
  onboardingSessions OnboardingSession[]
  collaborationsSent    Collaboration[] @relation("CollaborationInitiator")
  collaborationsDecided Collaboration[] @relation("CollaborationDecider")
  legalAcceptances  LegalAcceptance[]
  subscriptionStates SubscriptionState[]
}

model EntitlementPlan {
  id          String   @id @default(cuid())
  code        PlanTier @unique
  name        String
  description String?
  limitsJson  Json
  featuresJson Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  features    PlanFeatureEntitlement[]
}

/// Machine-readable plan limits. Runtime reads these rows, not plan-name branches.
model PlanFeatureEntitlement {
  id         String          @id @default(cuid())
  planId     String
  featureKey String
  enabled    Boolean         @default(true)
  limitInt   Int?
  valueText  String?
  plan       EntitlementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([planId, featureKey])
}

/// Country or account grants applied after the plan rows.
model EntitlementOverride {
  id          String    @id @default(cuid())
  planCode    PlanTier?
  countryCode String?
  subjectId   String?
  featureKey  String
  enabled     Boolean?
  limitInt    Int?
  valueText   String?
  active      Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Frozen entitlement set when a subscription changes.
model EntitlementSnapshot {
  id        String   @id @default(cuid())
  planCode  String
  subjectId String?
  reason    String
  payload   Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  objectType String
  objectId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Country {
  code     String  @id
  name     String
  enabled  Boolean @default(true)
  currency String
  locale   String  @default("en")
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  description String?
}

/// Ops intelligence prefs (Phase O). Replaces data/intelligence.json.
model IntelligenceSettings {
  id                 String    @id
  notes              String    @default("Phase 5 demo intelligence — synthetic trends + seed demographics.")
  watchedSpecialties String[]  @default(["beauty", "travel", "home-interior", "fashion"])
  lastExportAt       DateTime?
  updatedAt          DateTime  @updatedAt
}

model CmsSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  status    String   @default("published")
  updatedBy String?
  /// Banner / featured / value-prop content (Phase L.2). Layout-only sections stay null.
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMenuItem {
  id        String   @id @default(cuid())
  menu      String
  label     String
  href      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  kind      String
  status    String   @default("queued")
  payload   Json?
  attempts  Int      @default(0)
  lastError String?
  runAfter  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialty {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  parentId    String?
  parent      Specialty?  @relation("SpecialtyTree", fields: [parentId], references: [id])
  children    Specialty[] @relation("SpecialtyTree")
  creators    CreatorSpecialty[]
  synonyms    SpecialtySynonym[]
  offers      CollaborationOffer[]
  needs       CollaborationNeed[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SpecialtySynonym {
  id          String    @id @default(cuid())
  specialtyId String
  term        String    @unique
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Creator {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id])
  slug               String             @unique
  displayName        String
  title              String?
  bio                String?
  locationCity       String?
  locationCountry    String?
  languages          String[]           @default([])
  avatarUrl          String?
  coverUrl           String?
  /// Influencer-facing presentation gender for default avatars: male | female | unspecified
  gender             String             @default("unspecified")
  openToCollab       Boolean            @default(true)
  availability       String             @default("OPEN_TO_PARTNERSHIPS")
  identityVerified   VerificationStatus @default(UNVERIFIED)
  profileState       ProfileState       @default(UNCLAIMED)
  claimed            Boolean            @default(false)
  planTier           PlanTier           @default(STARTER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  specialties        CreatorSpecialty[]
  socialAccounts     SocialAccount[]
  card               InfluenceCard?
  collabOffers       CollaborationOffer[]
  collabNeeds        CollaborationNeed[]
  socialConnections  SocialConnection[]
  shortLinks         ShortLink[]
  payoutProfile      InfluencerPayoutProfile?
  mentorshipProfile  MentorshipProfile?
  mentorshipAsMentor MentorshipRequest[] @relation("MentorshipMentor")
  mentorshipAsMentee MentorshipRequest[] @relation("MentorshipMentee")
}

/// Collab OS P7 — influencer opt-in to mentor others (community mentoring by default).
model MentorshipProfile {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  /// open | paused | closed
  availability    String   @default("open")
  headline        String   @default("")
  boundaries      String   @default("")
  nichesJson      Json     @default("[]")
  maxActiveMentees Int      @default(5)
  /// Set only when admin eligibility passed at apply time.
  eligible        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/// Collab OS P7 — mentee → mentor request lifecycle.
model MentorshipRequest {
  id              String   @id @default(cuid())
  mentorCreatorId String
  menteeCreatorId String
  mentor          Creator  @relation("MentorshipMentor", fields: [mentorCreatorId], references: [id], onDelete: Cascade)
  mentee          Creator  @relation("MentorshipMentee", fields: [menteeCreatorId], references: [id], onDelete: Cascade)
  /// pending | accepted | declined | cancelled
  status          String   @default("pending")
  message         String   @default("")
  responseNote    String   @default("")
  /// Always false unless paid_mentoring product switch is on — never touches collab holding.
  paidRequested   Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([mentorCreatorId, status])
  @@index([menteeCreatorId, status])
}

/// Collab OS P5 — influencer payout methods + Global Payout Ready.
model InfluencerPayoutProfile {
  id                     String   @id @default(cuid())
  creatorId              String   @unique
  creator                Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  primaryMethod          String   @default("local_bank")
  primaryLabel           String   @default("Local bank")
  primaryStatus          String   @default("UNVERIFIED")
  primaryCountryCode     String?
  primaryCurrency        String?
  secondaryMethod        String?
  secondaryLabel         String?
  secondaryStatus        String   @default("UNVERIFIED")
  secondaryCountryCode   String?
  secondaryCurrency      String?
  globalPayoutReady      Boolean  @default(false)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

/// Collab OS P5 — Country Activation Matrix for collaboration corridors.
model CountryActivationCorridor {
  countryCode            String   @id
  active                 Boolean  @default(true)
  currency               String   @default("USD")
  collectionProviderCode String?
  payoutMethodsJson      Json     @default("[]")
  holdingEnabled         Boolean  @default(true)
  fxEnabled              Boolean  @default(false)
  kycModel               String   @default("identity_light")
  notes                  String   @default("")
  updatedAt              DateTime @updatedAt
}

model CreatorSpecialty {
  id          String    @id @default(cuid())
  creatorId   String
  specialtyId String
  isPrimary   Boolean   @default(false)
  source      DataSource @default(CREATOR_CLAIMED)
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([creatorId, specialtyId])
}

model SocialAccount {
  id           String         @id @default(cuid())
  creatorId    String
  platform     SocialPlatform
  handle       String
  url          String
  followers    Int?
  likes        Int?
  source       DataSource     @default(CREATOR_CLAIMED)
  refreshedAt  DateTime?
  creator      Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

/// Admin-edited terms a creator must accept before Influrios connects a social account.
model SocialConnectPolicy {
  id         String   @id @default("default")
  version    String
  termsText  String
  policyText String
  updatedAt  DateTime @updatedAt
}

/// One creator connection to a social network. Tokens stay encrypted. Counts are not copied here.
model SocialConnection {
  id              String         @id @default(cuid())
  creatorId       String
  creator         Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  providerId      String?
  status          String         @default("needs_consent")
  consentVersion  String?
  consentedAt     DateTime?
  stateToken      String?        @unique
  externalId      String?
  tokenCipher     String?
  refreshCipher   String?
  tokenExpiresAt  DateTime?
  lastError       String?
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([creatorId, platform])
}

model InfluenceCard {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  slug            String   @unique
  shortAlias      String?  @unique
  qrToken         String?  @unique
  theme           String   @default("starter")
  published       Boolean  @default(false)
  platformBrandVisible Boolean @default(true)
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CollaborationOffer {
  id          String     @id @default(cuid())
  creatorId   String
  specialtyId String?
  summary     String
  details     String?
  creator     Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([specialtyId])
}

model CollaborationNeed {
  id          String     @id @default(cuid())
  creatorId   String
  specialtyId String?
  summary     String
  details     String?
  creator     Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([specialtyId])
}

/// Admin-edited proposal window and commercial choices. Proposal counts live on plan entitlements.
model CollaborationSettings {
  id                String   @id @default("default")
  windowDays        Int      @default(30)
  commercialOptions String
  updatedAt         DateTime @updatedAt
}

/// A collaboration record (the Opportunity). Status moves draft → sent → accepted | declined, or withdrawn.
model Collaboration {
  id              String    @id @default(cuid())
  initiatorSlug   String
  recipientSlug   String
  initiatorUserId String?
  initiatorUser   User?     @relation("CollaborationInitiator", fields: [initiatorUserId], references: [id], onDelete: SetNull)
  decidedByUserId String?
  decidedByUser   User?     @relation("CollaborationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  title           String
  scope           String
  roleInitiator   String
  roleRecipient   String
  commercial      String
  status          String    @default("draft")
  why             String
  reasons         Json
  score           Int
  offerSpecialty  String?
  needSpecialty   String?
  sentAt          DateTime?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          CollaborationEvent[]
  signatures      SignatureRequest[]

  @@index([initiatorSlug, status])
  @@index([recipientSlug, status])
}

/// Admin-configured AI, payment, or document-signing connection. Secrets are ciphertext.
model IntegrationProvider {
  id             String   @id @default(cuid())
  kind           String
  code           String
  name           String
  enabled        Boolean  @default(false)
  baseUrl        String?
  publicKey      String?
  secretCipher   String?
  webhookCipher  String?
  extraJson      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  countryRoutes  PaymentCountryRoute[]
  aiRoutes       AiFunctionRoute[]
  signatures     SignatureRequest[]

  @@unique([kind, code])
}

/// One active payment gateway per country. Example: Flutterwave for NG, Stripe for US.
model PaymentCountryRoute {
  id          String              @id @default(cuid())
  countryCode String              @unique
  providerId  String
  provider    IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  active      Boolean             @default(true)
  updatedAt   DateTime            @updatedAt
}

/// Which AI provider serves a pipeline function. A null provider means the platform fallback.
model AiFunctionRoute {
  functionKey String               @id
  providerId  String?
  provider    IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  enabled     Boolean              @default(true)
  updatedAt   DateTime             @updatedAt
}

/// A signature request inside a collaboration. Queued is not signed.
model SignatureRequest {
  id              String               @id @default(cuid())
  collaborationId String
  collaboration   Collaboration        @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  status          String               @default("queued")
  title           String
  externalId      String               @default("")
  lastError       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([collaborationId])
}

model CollaborationEvent {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  actorUserId     String?
  note            String?
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

/// Public marketplace business request (Collab OS P1b). Replaces hardcoded BUSINESS_REQUESTS reads.
model MarketplaceBusinessRequest {
  id           String   @id @default(cuid())
  brand        String
  category     String
  budget       String
  location     String
  tags         String[] @default([])
  summary      String
  lookingFor   String
  logoUrl      String?
  imageUrl     String?
  status       String   @default("published")
  sortOrder    Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications MarketplaceApplication[]

  @@index([status, sortOrder])
}

/// Public marketplace creator opportunity (Collab OS P1b).
model MarketplaceCreatorOpportunity {
  id           String   @id @default(cuid())
  creatorSlug  String
  lookingFor   String
  summary      String
  purpose      String?
  location     String?
  status       String   @default("published")
  sortOrder    Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications MarketplaceApplication[]

  @@index([status, sortOrder])
  @@index([creatorSlug])
}

/// Persisted match explanation object (Collab OS §3.2).
model MarketplaceMatchRecord {
  id                       String    @id @default(cuid())
  matchType                String    @default("CREATOR_CREATOR")
  partyASlug               String
  partyBSlug               String
  score                    Int
  breakdownJson            Json
  reasonsJson              Json
  why                      String
  specialtyHits            String[]  @default([])
  modelVersion             String    @default("rules-v1")
  expiresAt                DateTime?
  convertedCollaborationId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  saves                    MarketplaceMatchSave[]

  @@unique([partyASlug, partyBSlug, matchType])
  @@index([score])
}

model MarketplaceMatchSave {
  id        String                 @id @default(cuid())
  matchId   String
  match     MarketplaceMatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?
  guestKey  String?
  createdAt DateTime               @default(now())

  @@index([matchId])
  @@index([userId])
  @@index([guestKey])
}

/// Invitation/application against a marketplace listing (§4.3 state machine).
model MarketplaceApplication {
  id                String                         @id @default(cuid())
  kind              String
  businessRequestId String?
  businessRequest   MarketplaceBusinessRequest?    @relation(fields: [businessRequestId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       MarketplaceCreatorOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromUserId        String?
  fromSlug          String?
  toSlug            String?
  status            String                         @default("REQUESTED")
  note              String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  events            MarketplaceApplicationEvent[]

  @@index([kind, status])
  @@index([businessRequestId])
  @@index([opportunityId])
}

model MarketplaceApplicationEvent {
  id            String                 @id @default(cuid())
  applicationId String
  application   MarketplaceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  actorUserId   String?
  note          String?
  createdAt     DateTime               @default(now())

  @@index([applicationId])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  industry    String?
  geography   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Demo business workspace persisted for briefs, shortlists, and inquiries.
model BusinessWorkspace {
  id         String                 @id @default("demo-business")
  name       String
  plan       String                 @default("BUSINESS_PRO")
  industry   String
  updatedAt  DateTime               @updatedAt
  briefs     BusinessBrief[]
  shortlist  BusinessShortlistItem[]
  inquiries  BusinessInquiry[]
  matchQueue ManagedMatchRequest[]
}

model BusinessBrief {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  goal        String
  specialty   String
  budget      String
  location    String
  platform    String
  summary     String
  status      String               @default("active")
  createdAt   DateTime             @default(now())
  inquiries   BusinessInquiry[]
  matchQueue  ManagedMatchRequest[]

  @@index([workspaceId])
}

model BusinessShortlistItem {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorSlug String
  note        String?
  addedAt     DateTime          @default(now())

  @@unique([workspaceId, creatorSlug])
}

model BusinessInquiry {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  briefId     String?
  brief       BusinessBrief?    @relation(fields: [briefId], references: [id], onDelete: SetNull)
  creatorSlug String
  message     String
  status      String            @default("sent")
  createdAt   DateTime          @default(now())

  @@index([workspaceId])
}

model CreatorManagedOptIn {
  creatorSlug    String   @id
  openToManaged  Boolean  @default(false)
  targetingNotes String   @default("")
  niches         String[] @default([])
  updatedAt      DateTime @updatedAt
}

model ManagedIntro {
  id           String              @id @default(cuid())
  businessName String
  businessId   String
  creatorSlug  String
  briefTitle   String
  briefId      String?
  notes        String              @default("")
  status       String              @default("draft")
  feeExpected  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  events       ManagedIntroEvent[]
  matchRequest ManagedMatchRequest?
}

model ManagedIntroEvent {
  id        String       @id @default(cuid())
  introId   String
  intro     ManagedIntro @relation(fields: [introId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime     @default(now())

  @@index([introId])
}

/// A business asked for managed matching. Admin records an introduction from the queue.
model ManagedMatchRequest {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  briefId     String
  brief       BusinessBrief     @relation(fields: [briefId], references: [id], onDelete: Cascade)
  status      String            @default("queued")
  introId     String?           @unique
  intro       ManagedIntro?     @relation(fields: [introId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([status])
}

model QrRedirect {
  id          String   @id @default(cuid())
  token       String   @unique
  targetUrl   String
  creatorId   String?
  campaign    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  creatorId   String?
  cardId      String?
  metaJson    Json?
  createdAt   DateTime @default(now())
}

/// Claim funnel session. Email verification is separate from social verification.
model OnboardingSession {
  id               String           @id
  state            OnboardingState  @default(DRAFT)
  inputHandle      String
  platform         String
  draftSlug        String           @unique
  email            String?
  ownerName        String?
  emailVerifiedAt  DateTime?
  socialVerifiedAt DateTime?
  publishedAt      DateTime?
  verifyMethod     String           @default("DEMO_CODE")
  payload          Json
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  claims           ProfileClaim[]
  attempts         VerificationAttempt[]
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  source     String
  acceptedAt DateTime @default(now())
}

/// Demo email code until SMTP exists. The plaintext is shown once on the verify screen.
model EmailChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  demoCode  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Marketing counters on the public footer strip. Admins edit these; the page does not hardcode them.
model FooterStat {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  iconKey   String
  tone      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Consent text, password rule, and the footer tagline. One row, edited in admin.
model SiteConfig {
  id                String   @id @default("default")
  footerTagline     String
  consentVersion    String
  consentCopy       String
  passwordMinLength Int      @default(8)
  updatedAt         DateTime @updatedAt
}

model GuestUsagePolicy {
  id              String   @id @default("default")
  profileViewSoft Int      @default(3)
  profileViewHard Int      @default(5)
  searchSoft      Int      @default(10)
  searchHard      Int      @default(20)
  softCopy        String
  hardCopy        String
  updatedAt       DateTime @updatedAt
}

model GuestUsage {
  id           String   @id
  profileViews Int      @default(0)
  searches     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model ProfileClaim {
  id        String             @id @default(cuid())
  sessionId String
  session   OnboardingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creatorId String?
  email     String
  status    String
  createdAt DateTime           @default(now())
}

model VerificationAttempt {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method    String
  channel   String
  success   Boolean           @default(false)
  detail    String?
  createdAt DateTime          @default(now())
}

/// Admin-edited outreach copy. Placeholders: {{name}} {{profile}} {{link}} {{expiry}}.
model InvitationTemplate {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  subject     String
  body        String
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  invitations CreatorInvitation[]
}

model InvitationCampaign {
  id          String              @id @default(cuid())
  name        String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  invitations CreatorInvitation[]
}

/// Default expiry and follow-up. Email delivery stays off until SMTP exists.
model InvitationSettings {
  id                 String   @id @default("default")
  defaultExpiryDays  Int      @default(14)
  defaultFollowUpDays Int     @default(7)
  updatedAt          DateTime @updatedAt
}

model OutreachSuppression {
  id        String   @id @default(cuid())
  kind      String
  value     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model CreatorInvitation {
  id          String               @id @default(cuid())
  token       String               @unique
  creatorSlug String
  displayName String
  email       String?
  templateId  String
  template    InvitationTemplate   @relation(fields: [templateId], references: [id])
  campaignId  String?
  campaign    InvitationCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status      String               @default("queued")
  expiresAt   DateTime
  followUpAt  DateTime?
  draftId     String?
  openedAt    DateTime?
  claimedAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  events      InvitationEvent[]
}

model InvitationEvent {
  id           String            @id @default(cuid())
  invitationId String
  invitation   CreatorInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  kind         String
  detail       String?
  actor        String?
  createdAt    DateTime          @default(now())
}

/// A provider event id is stored once. A duplicate delivery does not change the plan again.
model ProcessedWebhook {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  result    String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Normalized subscription status. Plan changes go through this row and the user record together.
model SubscriptionState {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  creatorSlug String?
  sku        String
  status     String
  provider   String
  externalId String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@index([userId])
}

/// Local checkout attempt (demo or Stripe). Replaces data/billing.json sessions.
model CheckoutAttempt {
  id              String    @id
  sku             String
  mode            String
  status          String    @default("open")
  customerEmail   String?
  userId          String?
  creatorSlug     String?
  stripeSessionId String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([stripeSessionId])
}

/// Admin SMTP settings. A blank or disabled row does not send mail.
model MailSettings {
  id           String   @id @default("default")
  host         String   @default("")
  port         Int      @default(587)
  username     String   @default("")
  fromAddress  String   @default("")
  secretCipher String?
  enabled      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model ProfileCompletionRule {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  hint      String
  weight    Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}

/// Hostname that serves inflr.me-style redirects. The primary row is the QR payload host.
model ShortLinkDomain {
  id        String   @id @default(cuid())
  hostname  String   @unique
  label     String
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)
  fallback  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Canonical app origin and https hosts a short link may redirect to.
model ShortLinkSettings {
  id               String   @id @default("default")
  canonicalOrigin  String
  allowedHosts     String
  updatedAt        DateTime @updatedAt
}

model ReservedSlug {
  slug      String   @id
  reason    String
  createdAt DateTime @default(now())
}

model ShortLink {
  id              String   @id @default(cuid())
  creatorId       String?
  creator         Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  slug            String   @unique
  destinationKind String   @default("profile")
  destination     String
  status          String   @default("active")
  dynamic         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  aliases         ShortLinkAlias[]
  qrIdentities    QrIdentity[]
  events          ShortLinkEvent[]
  abuseCases      ShortLinkAbuseCase[]
  destinationHistory ShortLinkDestinationHistory[]
}

/// Auditable destination changes for Pro dynamic short links (INFLR.me §9).
model ShortLinkDestinationHistory {
  id                  String    @id @default(cuid())
  shortLinkId         String
  shortLink           ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  previousDestination String
  previousKind        String
  destination         String
  destinationKind     String
  actorType           String
  actorId             String?
  reason              String    @default("update")
  createdAt           DateTime  @default(now())

  @@index([shortLinkId, createdAt])
}

model ShortLinkAlias {
  id          String    @id @default(cuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  slug        String    @unique
  redirect    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

/// Opaque QR payload. The token is not a slug and not the canonical profile URL.
model QrIdentity {
  id          String    @id @default(cuid())
  token       String    @unique
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
}

model ShortLinkEvent {
  id          String     @id @default(cuid())
  shortLinkId String?
  shortLink   ShortLink? @relation(fields: [shortLinkId], references: [id], onDelete: SetNull)
  eventType   String
  metaJson    Json?
  createdAt   DateTime   @default(now())

  @@index([shortLinkId, createdAt])
}

model ShortLinkAbuseCase {
  id          String     @id @default(cuid())
  shortLinkId String?
  shortLink   ShortLink? @relation(fields: [shortLinkId], references: [id], onDelete: SetNull)
  slug        String?
  status      String     @default("open")
  note        String
  createdAt   DateTime   @default(now())
}

/// One published version of a split legal document. Old versions stay in this table.
model LegalDocument {
  id                   String   @id @default(cuid())
  documentKey          String
  title                String
  version              String
  effectiveDate        DateTime
  jurisdiction         String   @default("global")
  roleScope            String   @default("all")
  featureTrigger       String
  requiresAcceptance   Boolean  @default(false)
  requiresReacceptance Boolean  @default(false)
  acknowledgementOnly  Boolean  @default(false)
  publishedStatus      String   @default("draft")
  bodyText             String
  documentHash         String
  supersedesId         String?
  category             String
  createdBy            String?
  createdAt            DateTime @default(now())
  publishedAt          DateTime?
  acceptances          LegalAcceptance[]

  @@unique([documentKey, version])
  @@index([featureTrigger, publishedStatus])
  @@index([category, publishedStatus])
}

/// Append-only acceptance or acknowledgement. Never overwrite a prior row.
model LegalAcceptance {
  id                String        @id @default(cuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectKey        String?
  documentId        String
  document          LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentKey       String
  documentVersion   String
  documentHash      String
  acceptedAt        DateTime      @default(now())
  acceptanceType    String
  acceptanceContext String
  userRole          String?
  country           String?
  ip                String?
  sessionMeta       String?

  @@index([userId, documentKey])
  @@index([subjectKey, documentKey])
  @@index([documentId])
}

/// Review window for milestone auto-approval. Commercial splits live on MilestoneTemplate.
model MarketplaceSettings {
  id                 String   @id @default("default")
  reviewWindowHours  Int      @default(72)
  templatesSeeded    Boolean  @default(false)
  cancelUnconfirmed      Boolean  @default(true)
  reasonsSeeded          Boolean  @default(false)
  attributionWindowDays    Int      @default(90)
  repeatMinGrossCents      Int      @default(0)
  sourcesSeeded            Boolean  @default(false)
  stagedFundingEnabled     Boolean  @default(true)
  recurringFundingEnabled  Boolean  @default(true)
  maxStages                Int      @default(4)
  recurringIntervalDays    Int      @default(30)
  maxRecurrences           Int      @default(6)
  fxSeeded                 Boolean  @default(false)
  sharesSeeded             Boolean  @default(false)
  maxRevisions             Int      @default(2)
  maxEvidence              Int      @default(5)
  maxGrossCents            Int      @default(0)
  partialRefundsEnabled    Boolean  @default(true)
  changeOrdersEnabled      Boolean  @default(true)
  maxChangeOrders          Int      @default(2)
  riskControlsEnabled      Boolean  @default(true)
  maxOpenDisputes          Int      @default(0)
  /// W3.5 — when false, the auto-approval job/sweep is a no-op.
  autoApprovalEnabled      Boolean  @default(true)
  /// W3.6 — kill fee on current milestone when brand cancels after work began (bps of milestone).
  killFeeBps               Int      @default(2500)
  killFeeFixedCents        Int      @default(0)
  updatedAt                DateTime @updatedAt
}

/// Protected payments and the word "escrow" are jurisdiction flags, not code switches.
/// W3.3 / Dev Addendum §6 — full capability matrix; flags override features (PA007).
model CollaborationJurisdiction {
  code                         String    @id
  label                        String
  protectedPaymentsEnabled     Boolean   @default(false)
  escrowTermAllowed            Boolean   @default(false)
  /// Full one-shot prefunding (schedule kind "once").
  fullPrefundingEnabled        Boolean   @default(true)
  stagedPrefundingEnabled      Boolean   @default(false)
  recurringFundingEnabled      Boolean   @default(false)
  /// Managed introduction service level (managed_intro). Fee rules alone never authorize.
  managedIntroductionEnabled   Boolean   @default(false)
  /// Managed negotiation / campaign service level (managed_campaign).
  managedNegotiationEnabled    Boolean   @default(false)
  /// JSON string array of approved marketplace provider codes; empty = any assigned provider.
  approvedProviderIds          String    @default("[]")
  /// APPROVED | PENDING | BLOCKED — Dev Addendum §24.
  legalReviewStatus            String    @default("APPROVED")
  capabilityNotes              String    @default("")
  capabilitiesEffectiveFrom    DateTime?
  capabilitiesEffectiveTo      DateTime?
  /// W3.5 — optional review window override (hours); null = marketplace settings default.
  reviewWindowHours            Int?
  /// W3.5 — optional max revisions override; null = marketplace settings default.
  maxRevisions                 Int?
  currency                     String    @default("USD")
  minorDigits                  Int       @default(2)
  providerCode                 String    @default("primary")
  updatedAt                    DateTime  @updatedAt
}

/// Versioned collaboration fee rules (Phase O). Replaces data/collaboration-fees.json rules[].
/// Funding immutability stays on CollaborationFunding.feeSnapshotJson — this table is the live matrix.
model CollaborationFeeRule {
  id            String   @id
  name          String
  version       Int      @default(1)
  active        Boolean  @default(true)
  priority      Int      @default(100)
  jurisdiction  String   @default("*")
  serviceLevel  String   @default("contracted")
  /// Distinct commercial fee type (platform_service, collaboration, managed_intro, …) — Product Addendum §5.
  feeType       String   @default("collaboration")
  minGrossCents Int?
  maxGrossCents Int?
  method        String   @default("percent")
  percentBps    Int      @default(0)
  fixedCents    Int      @default(0)
  minFeeCents   Int      @default(0)
  maxFeeCents   Int?
  payer         String   @default("brand")
  effectiveFrom DateTime
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, priority])
  @@index([jurisdiction, serviceLevel])
}

/// Admin fee-simulator freezes only. Prefund fee history lives on CollaborationFunding.feeSnapshotJson.
model CollaborationFeeSnapshot {
  id                 String   @id
  ruleId             String
  ruleName           String
  ruleVersion        Int
  method             String
  payer              String
  /// Distinct fee type frozen with the admin simulator snapshot.
  feeType            String   @default("collaboration")
  basisCents         Int
  percentBps         Int
  fixedCents         Int
  calculatedFeeCents Int
  jurisdiction       String
  serviceLevel       String
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

/// Admin share of a prefund. Active rows must add up to 10000 basis points.
model MilestoneTemplate {
  id        String   @id @default(cuid())
  title     String
  shareBps  Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// A prefund intent. Held only after the marketplace provider confirms.
model CollaborationFunding {
  id               String   @id @default(cuid())
  jurisdictionCode String
  businessName     String
  creatorSlug      String
  title            String
  currency         String   @default("USD")
  grossCents       Int
  feeCents         Int      @default(0)
  feeSnapshotJson  Json
  fxSnapshotJson   Json?
  shareSnapshotJson Json?
  serviceLevel     String
  status            String   @default("awaiting_provider")
  providerCode      String
  attributionLabel  String   @default("")
  /// W3.7 — active | expired | contested | pre_existing
  attributionStatus String   @default("active")
  attributionExpiresAt DateTime?
  scheduleId        String?
  scheduleKind      String   @default("once")
  /// Product Addendum §7 mode: FULL | STAGED | NONE (recurring deferred as schedule kind only).
  fundingMode       String   @default("FULL")
  trancheIndex      Int      @default(1)
  trancheCount      Int      @default(1)
  intervalDays      Int      @default(0)
  repeatOfId        String?
  repeatOf          CollaborationFunding?  @relation("FundingRepeat", fields: [repeatOfId], references: [id], onDelete: SetNull)
  repeats           CollaborationFunding[] @relation("FundingRepeat")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  changeOrderLimit  Int      @default(2)
  changeOrderCount  Int      @default(0)
  milestones        FundingMilestone[]
  entries           LedgerEntry[]
  disputes          MilestoneDispute[]
  changeOrders      FundingChangeOrder[]

  @@unique([scheduleId, trancheIndex])
  @@index([creatorSlug, status])
  @@index([status])
  @@index([repeatOfId])
  @@index([scheduleId])
}

model FundingMilestone {
  id                String               @id @default(cuid())
  fundingId         String
  funding           CollaborationFunding @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  title             String
  amountCents       Int
  refundedCents     Int                  @default(0)
  sortOrder         Int                  @default(0)
  status            String               @default("pending")
  /// W3.10 — usage rights are separate from milestone acceptance (Product §13).
  rightsStatus      String               @default("pending")
  /// release (default) | acceptance | custom
  rightsActivateOn  String               @default("release")
  rightsActivatedAt DateTime?
  reviewWindowHours Int
  revisionLimit     Int                  @default(2)
  revisionCount     Int                  @default(0)
  revisionNote      String               @default("")
  submittedAt       DateTime?
  autoApproveAt     DateTime?
  approvedAt        DateTime?
  updatedAt         DateTime             @updatedAt
  entries           LedgerEntry[]
  disputes          MilestoneDispute[]

  @@index([fundingId, status])
}

/// Provider-held movements. This is not an Influrios cash balance.
model LedgerEntry {
  id             String               @id @default(cuid())
  fundingId      String
  funding        CollaborationFunding @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      FundingMilestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  kind           String
  amountCents    Int
  party          String               @default("")
  /// Collab OS P4 logical domain: OPERATIONS | COLLABORATION_HOLDING | …
  accountPurpose String               @default("")
  provider       String
  eventId        String
  createdAt      DateTime             @default(now())

  @@unique([provider, eventId, kind, party])
  @@index([fundingId])
}

/// Admin FX rate. Minor units of this currency per 1.00 USD. Not a live quote.
model FxRate {
  currency    String   @id
  minorPerUsd Int
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

/// Admin split of a provider release. Active rows must add up to 10000 basis points.
model RevenueParty {
  id        String   @id @default(cuid())
  label     String
  shareBps  Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Admin-edited sources. The label is copied onto a funding when the prefund is requested.
model AttributionSource {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// W3.7 — contested pre-existing relationship claims (Dev Addendum §15).
model AttributionClaim {
  id           String    @id @default(cuid())
  businessName String
  creatorSlug  String
  fundingId    String?
  claimType    String    @default("PRE_EXISTING_RELATIONSHIP")
  status       String    @default("open")
  evidence     String    @default("")
  adminNote    String    @default("")
  filedBy      String    @default("business")
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([businessName, creatorSlug])
  @@index([fundingId])
}

/// Admin-edited reasons. The label is copied onto a dispute when it is opened.
model DisputeReason {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A documented amendment while the prefund is still waiting for the provider.
model FundingChangeOrder {
  id                      String               @id @default(cuid())
  fundingId               String
  funding                 CollaborationFunding @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  note                    String
  previousGrossCents      Int
  nextGrossCents          Int
  previousUsdCents        Int
  nextUsdCents            Int
  previousFeeSnapshotJson Json
  createdAt               DateTime             @default(now())

  @@index([fundingId])
}

/// A milestone dispute or a request to cancel money the provider is holding.
model MilestoneDispute {
  id                   String                @id @default(cuid())
  fundingId            String
  funding              CollaborationFunding  @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  milestoneId          String?
  milestone            FundingMilestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  openedBy             String
  reasonLabel          String
  details              String
  status               String                @default("open")
  requestedRefundCents Int?
  evidenceLimit        Int                   @default(5)
  resolutionNote       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  notes                DisputeNote[]

  @@index([fundingId, status])
  @@index([milestoneId, status])
}

model DisputeNote {
  id        String           @id @default(cuid())
  disputeId String
  dispute   MilestoneDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author    String
  body      String
  url       String           @default("")
  createdAt DateTime         @default(now())

  @@index([disputeId])
}

/// Agency roster, campaigns, portfolios, and named seats. Seats stay closed until admin turns them on.
model AgencyWorkspace {
  id         String               @id
  name       String
  plan       String               @default("AGENCY")
  notes      String               @default("")
  updatedAt  DateTime             @updatedAt
  roster     AgencyRosterMember[]
  campaigns  AgencyCampaign[]
  portfolios AgencyPortfolio[]
  seats      AgencySeat[]
}

model AgencyRosterMember {
  id            String          @id @default(cuid())
  workspaceId   String
  workspace     AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorSlug   String
  role          String          @default("talent")
  retainerLabel String          @default("Project")
  notes         String          @default("")
  addedAt       DateTime        @default(now())

  @@unique([workspaceId, creatorSlug])
}

model AgencyCampaign {
  id           String          @id
  workspaceId  String
  workspace    AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  clientName   String
  status       String          @default("briefing")
  specialty    String
  budgetLabel  String
  creatorSlugs Json
  summary      String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([workspaceId, status])
}

model AgencyPortfolio {
  id          String          @id
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  tagline     String          @default("")
  leftSlug    String
  rightSlug   String
  specialty   String
  outcome     String          @default("")
  metricsJson Json
  campaignId  String?
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, published])
}

model AgencySeat {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String          @default("member")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, email])
}

/// Ops console RBAC (Phase L). Replaces data/admin-auth.json.
model AdminRole {
  id          String      @id
  name        String
  description String      @default("")
  system      Boolean     @default(false)
  permissions String[]  @default([])
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AdminUser {
  id           String    @id
  email        String    @unique
  name         String
  roleId       String
  role         AdminRole @relation(fields: [roleId], references: [id])
  passwordHash String
  passwordSalt String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
}
