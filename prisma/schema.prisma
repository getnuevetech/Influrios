generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  BUSINESS
  AGENCY
  ADMIN
}

enum PlanTier {
  STARTER
  PLUS
  PRO
  BUSINESS_FREE
  BUSINESS_PRO
  AGENCY
}

enum DataSource {
  CREATOR_CLAIMED
  PLATFORM_VERIFIED
  PROVIDER_SYNCED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileState {
  UNCLAIMED
  CLAIMED
  VERIFIED
  RESTRICTED
}

enum OnboardingState {
  DRAFT
  CLAIMED
  EMAIL_VERIFIED
  PUBLISHED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  LINKEDIN
  PINTEREST
  WEBSITE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  role            UserRole  @default(CREATOR)
  planTier        PlanTier  @default(STARTER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         Creator?
  business        BusinessProfile?
  consents        ConsentRecord[]
  emailChallenges EmailChallenge[]
  passwordResets  PasswordReset[]
  onboardingSessions OnboardingSession[]
  collaborationsSent    Collaboration[] @relation("CollaborationInitiator")
  collaborationsDecided Collaboration[] @relation("CollaborationDecider")
}

model EntitlementPlan {
  id          String   @id @default(cuid())
  code        PlanTier @unique
  name        String
  description String?
  limitsJson  Json
  featuresJson Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  features    PlanFeatureEntitlement[]
}

/// Machine-readable plan limits. Runtime reads these rows, not plan-name branches.
model PlanFeatureEntitlement {
  id         String          @id @default(cuid())
  planId     String
  featureKey String
  enabled    Boolean         @default(true)
  limitInt   Int?
  valueText  String?
  plan       EntitlementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([planId, featureKey])
}

/// Country or account grants applied after the plan rows.
model EntitlementOverride {
  id          String    @id @default(cuid())
  planCode    PlanTier?
  countryCode String?
  subjectId   String?
  featureKey  String
  enabled     Boolean?
  limitInt    Int?
  valueText   String?
  active      Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Frozen entitlement set when a subscription changes.
model EntitlementSnapshot {
  id        String   @id @default(cuid())
  planCode  String
  subjectId String?
  reason    String
  payload   Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  objectType String
  objectId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Country {
  code     String  @id
  name     String
  enabled  Boolean @default(true)
  currency String
  locale   String  @default("en")
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  description String?
}

model CmsSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  status    String   @default("published")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMenuItem {
  id        String   @id @default(cuid())
  menu      String
  label     String
  href      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  kind      String
  status    String   @default("queued")
  payload   Json?
  attempts  Int      @default(0)
  lastError String?
  runAfter  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialty {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  parentId    String?
  parent      Specialty?  @relation("SpecialtyTree", fields: [parentId], references: [id])
  children    Specialty[] @relation("SpecialtyTree")
  creators    CreatorSpecialty[]
  synonyms    SpecialtySynonym[]
  offers      CollaborationOffer[]
  needs       CollaborationNeed[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SpecialtySynonym {
  id          String    @id @default(cuid())
  specialtyId String
  term        String    @unique
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Creator {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id])
  slug               String             @unique
  displayName        String
  title              String?
  bio                String?
  locationCity       String?
  locationCountry    String?
  languages          String[]           @default([])
  avatarUrl          String?
  coverUrl           String?
  openToCollab       Boolean            @default(true)
  availability       String             @default("OPEN_TO_PARTNERSHIPS")
  identityVerified   VerificationStatus @default(UNVERIFIED)
  profileState       ProfileState       @default(UNCLAIMED)
  claimed            Boolean            @default(false)
  planTier           PlanTier           @default(STARTER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  specialties        CreatorSpecialty[]
  socialAccounts     SocialAccount[]
  card               InfluenceCard?
  collabOffers       CollaborationOffer[]
  collabNeeds        CollaborationNeed[]
}

model CreatorSpecialty {
  id          String    @id @default(cuid())
  creatorId   String
  specialtyId String
  isPrimary   Boolean   @default(false)
  source      DataSource @default(CREATOR_CLAIMED)
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([creatorId, specialtyId])
}

model SocialAccount {
  id           String         @id @default(cuid())
  creatorId    String
  platform     SocialPlatform
  handle       String
  url          String
  followers    Int?
  source       DataSource     @default(CREATOR_CLAIMED)
  refreshedAt  DateTime?
  creator      Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model InfluenceCard {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  slug            String   @unique
  shortAlias      String?  @unique
  qrToken         String?  @unique
  theme           String   @default("starter")
  published       Boolean  @default(false)
  platformBrandVisible Boolean @default(true)
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CollaborationOffer {
  id          String     @id @default(cuid())
  creatorId   String
  specialtyId String?
  summary     String
  details     String?
  creator     Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([specialtyId])
}

model CollaborationNeed {
  id          String     @id @default(cuid())
  creatorId   String
  specialtyId String?
  summary     String
  details     String?
  creator     Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([specialtyId])
}

/// Admin-edited proposal window and commercial choices. Proposal counts live on plan entitlements.
model CollaborationSettings {
  id                String   @id @default("default")
  windowDays        Int      @default(30)
  commercialOptions String
  updatedAt         DateTime @updatedAt
}

/// A collaboration record (the Opportunity). Status moves draft → sent → accepted | declined, or withdrawn.
model Collaboration {
  id              String    @id @default(cuid())
  initiatorSlug   String
  recipientSlug   String
  initiatorUserId String?
  initiatorUser   User?     @relation("CollaborationInitiator", fields: [initiatorUserId], references: [id], onDelete: SetNull)
  decidedByUserId String?
  decidedByUser   User?     @relation("CollaborationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  title           String
  scope           String
  roleInitiator   String
  roleRecipient   String
  commercial      String
  status          String    @default("draft")
  why             String
  reasons         Json
  score           Int
  offerSpecialty  String?
  needSpecialty   String?
  sentAt          DateTime?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          CollaborationEvent[]
  signatures      SignatureRequest[]

  @@index([initiatorSlug, status])
  @@index([recipientSlug, status])
}

/// Admin-configured AI, payment, or document-signing connection. Secrets are ciphertext.
model IntegrationProvider {
  id             String   @id @default(cuid())
  kind           String
  code           String
  name           String
  enabled        Boolean  @default(false)
  baseUrl        String?
  publicKey      String?
  secretCipher   String?
  webhookCipher  String?
  extraJson      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  countryRoutes  PaymentCountryRoute[]
  aiRoutes       AiFunctionRoute[]
  signatures     SignatureRequest[]

  @@unique([kind, code])
}

/// One active payment gateway per country. Example: Flutterwave for NG, Stripe for US.
model PaymentCountryRoute {
  id          String              @id @default(cuid())
  countryCode String              @unique
  providerId  String
  provider    IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  active      Boolean             @default(true)
  updatedAt   DateTime            @updatedAt
}

/// Which AI provider serves a pipeline function. A null provider means the platform fallback.
model AiFunctionRoute {
  functionKey String               @id
  providerId  String?
  provider    IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  enabled     Boolean              @default(true)
  updatedAt   DateTime             @updatedAt
}

/// A signature request inside a collaboration. Queued is not signed.
model SignatureRequest {
  id              String               @id @default(cuid())
  collaborationId String
  collaboration   Collaboration        @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  status          String               @default("queued")
  title           String
  lastError       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([collaborationId])
}

model CollaborationEvent {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  actorUserId     String?
  note            String?
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

model BusinessProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  industry    String?
  geography   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QrRedirect {
  id          String   @id @default(cuid())
  token       String   @unique
  targetUrl   String
  creatorId   String?
  campaign    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  creatorId   String?
  cardId      String?
  metaJson    Json?
  createdAt   DateTime @default(now())
}

/// Claim funnel session. Email verification is separate from social verification.
model OnboardingSession {
  id               String           @id
  state            OnboardingState  @default(DRAFT)
  inputHandle      String
  platform         String
  draftSlug        String           @unique
  email            String?
  ownerName        String?
  emailVerifiedAt  DateTime?
  socialVerifiedAt DateTime?
  publishedAt      DateTime?
  verifyMethod     String           @default("DEMO_CODE")
  payload          Json
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  claims           ProfileClaim[]
  attempts         VerificationAttempt[]
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  source     String
  acceptedAt DateTime @default(now())
}

/// Demo email code until SMTP exists. The plaintext is shown once on the verify screen.
model EmailChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  demoCode  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Marketing counters on the public footer strip. Admins edit these; the page does not hardcode them.
model FooterStat {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  iconKey   String
  tone      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Consent text, password rule, and the footer tagline. One row, edited in admin.
model SiteConfig {
  id                String   @id @default("default")
  footerTagline     String
  consentVersion    String
  consentCopy       String
  passwordMinLength Int      @default(8)
  updatedAt         DateTime @updatedAt
}

model GuestUsagePolicy {
  id              String   @id @default("default")
  profileViewSoft Int      @default(3)
  profileViewHard Int      @default(5)
  searchSoft      Int      @default(10)
  searchHard      Int      @default(20)
  softCopy        String
  hardCopy        String
  updatedAt       DateTime @updatedAt
}

model GuestUsage {
  id           String   @id
  profileViews Int      @default(0)
  searches     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model ProfileClaim {
  id        String             @id @default(cuid())
  sessionId String
  session   OnboardingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creatorId String?
  email     String
  status    String
  createdAt DateTime           @default(now())
}

model VerificationAttempt {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method    String
  channel   String
  success   Boolean           @default(false)
  detail    String?
  createdAt DateTime          @default(now())
}

/// Admin-edited outreach copy. Placeholders: {{name}} {{profile}} {{link}} {{expiry}}.
model InvitationTemplate {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  subject     String
  body        String
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  invitations CreatorInvitation[]
}

model InvitationCampaign {
  id          String              @id @default(cuid())
  name        String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  invitations CreatorInvitation[]
}

/// Default expiry and follow-up. Email delivery stays off until SMTP exists.
model InvitationSettings {
  id                 String   @id @default("default")
  defaultExpiryDays  Int      @default(14)
  defaultFollowUpDays Int     @default(7)
  updatedAt          DateTime @updatedAt
}

model OutreachSuppression {
  id        String   @id @default(cuid())
  kind      String
  value     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model CreatorInvitation {
  id          String               @id @default(cuid())
  token       String               @unique
  creatorSlug String
  displayName String
  email       String?
  templateId  String
  template    InvitationTemplate   @relation(fields: [templateId], references: [id])
  campaignId  String?
  campaign    InvitationCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status      String               @default("queued")
  expiresAt   DateTime
  followUpAt  DateTime?
  draftId     String?
  openedAt    DateTime?
  claimedAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  events      InvitationEvent[]
}

model InvitationEvent {
  id           String            @id @default(cuid())
  invitationId String
  invitation   CreatorInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  kind         String
  detail       String?
  actor        String?
  createdAt    DateTime          @default(now())
}

model ProfileCompletionRule {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  hint      String
  weight    Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}
