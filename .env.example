# Copy to `.env` for local development and to `/var/www/influrios/.env` on Lightsail.

# App (public URL of this server)
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://YOUR_LIGHTSAIL_IP
NEXT_PUBLIC_SHORT_LINK_HOST=inflr.me
# Extra short hostnames recognized before the database is consulted, comma-separated.
# SHORT_LINK_HOSTS=

# ---------------------------------------------------------------------------
# Docker PostgreSQL credentials
# The web container talks to Postgres via Docker network hostname "postgres".
# Host-side tools (prisma seed from the server shell) use 127.0.0.1 below.
# ---------------------------------------------------------------------------
POSTGRES_USER=influrios
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=influrios

# For host-side prisma/npm tools only (published port on localhost)
DATABASE_URL="postgresql://influrios:change-me-to-a-strong-password@127.0.0.1:5432/influrios?schema=public"

# Auth / Admin access control (Postgres AdminUser / AdminRole — not JSON)
# AUTH_SECRET=generate-a-long-random-string
# ADMIN_SESSION_SECRET=generate-another-long-random-string
# CRON_SECRET=generate-a-third-long-random-string
# Meilisearch. Compose sets MEILI_HOST to the meilisearch service.
# MEILI_HOST=http://meilisearch:7700
# MEILI_API_KEY=generate-a-meili-master-key
# Host crontab: */5 * * * * CRON_SECRET=... APP_URL=https://your-domain /var/www/influrios/deploy/scripts/sweep-cron.sh
# Stable across deploys. deploy.sh creates this once when it is empty.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# First boot creates this Super Admin when AdminUser is empty (and no legacy JSON to import).
# ADMIN_SUPER_EMAIL=admin@influrios.com
# ADMIN_SUPER_PASSWORD=change-me-strong-password
# Leave product switch legacy_demo_payments off in production (default).

# ---------------------------------------------------------------------------
# Phase 6 — Stripe monetization (optional; demo checkout works without keys)
# ---------------------------------------------------------------------------
# Sandbox keys start with sk_test_ or rkcs_test_. A key saved on the Stripe gateway is used when this is unset.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Register webhook: {NEXT_PUBLIC_APP_URL}/api/billing/webhook
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional Price IDs (otherwise Checkout uses price_data from catalog amounts)
# STRIPE_PRICE_CREATOR_PLUS=price_...
# STRIPE_PRICE_CREATOR_PRO=price_...
# STRIPE_PRICE_BUSINESS_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...

# ---------------------------------------------------------------------------
# Phase M — SMTP (optional; admin /admin/mail can supply the same values)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Social OAuth client id/secret are stored in Admin → Social (not env).
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/social/callback
# Marketplace provider webhook secret is stored on the gateway row.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/marketplace/webhook
# Staging runbook: docs/deploy/STAGING_LAUNCH_INTEGRATIONS.md
