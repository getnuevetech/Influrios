# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Copy to `.env` for local development and to `/var/www/influrios/.env` on Lightsail.

# App
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SHORT_LINK_HOST=ic.me

# PostgreSQL (Lightsail managed DB or local Docker)
# Local docker-compose default:
DATABASE_URL="postgresql://influrios:influrios@localhost:5432/influrios?schema=public"

# Lightsail managed database example:
# DATABASE_URL="postgresql://dbmasteruser:PASSWORD@ls-xxxx.xxxxxx.us-east-1.rds.amazonaws.com:5432/influrios?schema=public&sslmode=require"

# Auth (Phase 1 — placeholder until Clerk/Auth.js wired)
# AUTH_SECRET=generate-a-long-random-string
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
