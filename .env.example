# Copy to `.env` for local development and to `/var/www/influrios/.env` on Lightsail.

# App
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SHORT_LINK_HOST=ic.me

# ---------------------------------------------------------------------------
# Docker PostgreSQL (recommended for Lightsail + local)
# Start with: docker compose up -d
# ---------------------------------------------------------------------------
POSTGRES_USER=influrios
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=influrios

# Must match the Docker credentials above (host is localhost / 127.0.0.1)
DATABASE_URL="postgresql://influrios:change-me-to-a-strong-password@127.0.0.1:5432/influrios?schema=public"

# Auth (Phase 1 — placeholder until Clerk/Auth.js wired)
# AUTH_SECRET=generate-a-long-random-string
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
